{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach API",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Debug Angular",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src/customer-dashboard-ui",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Debug API and Angular",
      "configurations": [
        "Attach API",
        "Debug Angular"
      ]
    }
  ]
}
